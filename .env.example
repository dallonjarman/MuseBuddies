# Public address of your relay. Muses connect to it, and invitation links use it.
PUBLIC_URL=https://muse.example.com

# Domain for automatic HTTPS (the https profile). Point its DNS A/AAAA record at this server.
DOMAIN=muse.example.com

# Optional
# RELAY_IMAGE=ghcr.io/dallonjarman/musetogether:latest
# RELAY_BIND=127.0.0.1
# RELAY_PORT=8787
# TRUST_PROXY=1
